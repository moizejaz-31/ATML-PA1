# ==============================================================================
# Gitignore for ATML PA1: Beyond IID
# The manual's repository deliverables: code, configuration files, split
# logic/indices, environment specification, machine-readable results, README.
# Kept:     .py source, notebooks, requirements.txt, READMEs,
#           results/*.csv + *.json, split files, run configs (*_history.json),
#           Task 1 evaluation-subset indices.
# Excluded: datasets, model weights, cached features, figures/images,
#           the report, logs, and temporary/legacy runs.
# ==============================================================================

# --- Academic Report & LaTeX (the PDF is submitted on LMS) ---
report/
*.pdf
*.tex
*.bib
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls

# --- Text Files (manual extracts, notes; keep requirements.txt) ---
*.txt
!requirements.txt

# --- Datasets & Raw Archives ---
data/
datasets/
*.tar
*.tar.gz
*.tgz
*.zip
*.gz
*.bin

# --- Model Checkpoints & Pretrained Weights ---
# Weights are excluded; the small *_history.json next to each checkpoint holds the
# run's exact configuration + training curves, so it is kept.
*.pth
*.pt
*.ckpt
*.onnx
**/checkpoints/*
!**/checkpoints/*_history.json

# --- Cached Feature Representations & Arrays ---
# Task 1's selected evaluation-image indices are kept (manual: save the selected identifiers).
*.npy
*.npz
**/cache/*
!task1_inductive_biases/cache/eval_indices.npy

# --- Figures & Images (plots stay embedded in the executed notebooks) ---
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
*.mp4

# --- Superseded / unused runs ---
**/results/legacy_*/
task4_open_set/notebooks/0_colab_setup.ipynb

# --- Python Bytecode & Package Builds ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Jupyter Checkpoints & Temporary Runs ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
scratch/

# --- IDEs, Editors & OS Metadata ---
.vscode/
.idea/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Experiment Tracking ---
wandb/
runs/
